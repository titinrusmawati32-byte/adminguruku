{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role admin or guru and academic assignments",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "guru"] },
        "teacherId": { "type": "string", "maxLength": 128 },
        "nip": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "assignedClasses": { "type": "string" },
        "assignedSubjects": { "type": "string" },
        "isHomeroom": { "type": "string" },
        "homeroomClass": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username", "displayName", "role", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with NIS, NISN, class, and QR code",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "nis": { "type": "string", "maxLength": 32 },
        "nisn": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "classId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "qrCode": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "nis", "nisn", "name", "gender", "classId", "status"]
    },
    "Class": {
      "title": "Class",
      "description": "Class grade and section",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "maxLength": 16 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["classId", "name", "grade", "academicYear"]
    },
    "Subject": {
      "title": "Subject",
      "description": "School course / mapel",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "group": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subjectId", "code", "name", "group", "status"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Teaching timetable schedule",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "day": { "type": "string", "maxLength": 16 },
        "startTime": { "type": "string", "maxLength": 16 },
        "endTime": { "type": "string", "maxLength": 16 },
        "room": { "type": "string", "maxLength": 64 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "semester": { "type": "string", "enum": ["1", "2"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["scheduleId", "teacherId", "classId", "subjectId", "day", "startTime", "endTime"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance record",
      "type": "object",
      "properties": {
        "attendanceId": { "type": "string", "maxLength": 128 },
        "scheduleId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "studentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Hadir", "Sakit", "Izin", "Alpa"] },
        "notes": { "type": "string", "maxLength": 256 },
        "method": { "type": "string", "enum": ["manual", "qr"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["attendanceId", "classId", "date", "studentId", "status"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Student grade assessment record",
      "type": "object",
      "properties": {
        "assessmentId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["tugas", "formatif", "sumatif"] },
        "title": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "maxScore": { "type": "number" },
        "scores": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["assessmentId", "classId", "subjectId", "teacherId", "type", "title", "date"]
    },
    "TeachingAgenda": {
      "title": "TeachingAgenda",
      "description": "Teacher daily teaching agenda",
      "type": "object",
      "properties": {
        "agendaId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "scheduleId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "topic": { "type": "string", "maxLength": 256 },
        "learningObjective": { "type": "string", "maxLength": 512 },
        "activity": { "type": "string", "maxLength": 1000 },
        "attendanceSummary": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["agendaId", "teacherId", "classId", "subjectId", "date", "topic"]
    },
    "Guidance": {
      "title": "Guidance",
      "description": "Homeroom teacher counseling and guidance record",
      "type": "object",
      "properties": {
        "guidanceId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "enum": ["Akademik", "Kehadiran", "Perilaku", "Sosial", "Prestasi", "Lainnya"] },
        "problem": { "type": "string", "maxLength": 1000 },
        "action": { "type": "string", "maxLength": 1000 },
        "followUp": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["guidanceId", "teacherId", "studentId", "date", "category", "problem", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "success", "warning"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["notificationId", "title", "message", "type", "read"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity audit log",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "collection": { "type": "string", "maxLength": 64 },
        "documentId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" },
        "details": { "type": "string", "maxLength": 500 }
      },
      "required": ["logId", "userId", "action", "collection", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "System users collection"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students collection"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Classes collection"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects collection"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Schedules collection"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Attendance logs collection"
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "Assessments collection"
    },
    "/teaching_agendas/{agendaId}": {
      "schema": { "$ref": "#/entities/TeachingAgenda" },
      "description": "Teaching agendas collection"
    },
    "/guidance/{guidanceId}": {
      "schema": { "$ref": "#/entities/Guidance" },
      "description": "Counseling and guidance collection"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs"
    }
  }
}
