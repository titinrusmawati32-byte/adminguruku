rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return true;
    }

    function isBootstrappedAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'bahanajarp@gmail.com' ||
        request.auth.token.email == 'frezafa20@gmail.com' ||
        request.auth.token.email == 'susipalupiningdyah25@admin.sd.belajar.id' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@admin\\.sd\\.belajar\\.id'))
      );
    }

    function isAdmin() {
      return true;
    }

    // Health check test collection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Classes collection
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Assessments collection
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Teaching Agendas collection
    match /teaching_agendas/{agendaId} {
      allow read, write: if true;
    }

    // Guidance / Bimbingan collection
    match /guidance/{guidanceId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
